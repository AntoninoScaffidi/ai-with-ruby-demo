<div class="max-w-xl mx-auto mt-16 px-4">
  <h1 class="text-2xl font-semibold mb-6">RubyLLM chat demo</h1>

  <%= form_with url: chat_path, method: :post, data: { turbo: false }, class: "flex flex-col gap-3" do %>
    <textarea
      name="message"
      rows="3"
      placeholder="Ask something..."
      class="border border-gray-300 rounded-md p-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
    ><%= @message %></textarea>

    <button
      type="submit"
      class="self-start bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700"
    >
      Send
    </button>
  <% end %>

  <% if @response %>
    <div class="mt-8 border-t border-gray-200 pt-6">
      <p class="text-sm text-gray-500 mb-1">Response:</p>
      <p class="whitespace-pre-wrap"><%= @response %></p>
    </div>
  <% end %>
</div>
